{
  "name": "app",
  "version": "1.1.0",
  "engines": {
    "node": "20.18.1",
    "npm": "10.8.2"
  },
  "scripts": {
    "ng": "ng",
    "start": "npm run serve:ssr",
    "deploy": "ng build --configuration production && npm run build:ssr && gcloud app deploy",
    "build": "ng build",
    "build:production": "npm run build:ssr && npm run build:copy:files",
    "build:render": "ng build --configuration=production && ng run app:server:production && npx angular-prerender --browser-target app:build --server-target app:server && cp CNAME dist/app/browser/CNAME",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "dev:ssr": "ng run app:serve-ssr",
    "serve:ssr": "node dist/app/server/main.js",
    "build:ssr": "ng build --configuration production && ng run app:server:production",
    "prerender": "ng run app:prerender"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.1.2",
    "@angular/common": "^21.1.2",
    "@angular/compiler": "^21.1.2",
    "@angular/core": "^21.1.2",
    "@angular/forms": "^21.1.2",
    "@angular/platform-browser": "^21.1.2",
    "@angular/platform-browser-dynamic": "^21.1.2",
    "@angular/platform-server": "^21.1.2",
    "@angular/router": "^21.1.2",
    "@angular/ssr": "^21.1.2",
    "@mdi/font": "^7.0.96",
    "angular-cli-ghpages": "^1.0.5",
    "express": "^4.18.2",
    "html-minifier-terser": "^7.2.0",
    "rxjs": "^7.5.7",
    "tslib": "^2.4.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^21.0.0",
    "@angular-devkit/build-angular": "^21.1.2",
    "@angular-eslint/builder": "16.3.1",
    "@angular-eslint/eslint-plugin": "16.3.1",
    "@angular-eslint/eslint-plugin-template": "16.3.1",
    "@angular-eslint/schematics": "16.3.1",
    "@angular-eslint/template-parser": "16.3.1",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.2",
    "@angular/language-service": "^21.1.2",
    "@types/express": "^4.17.14",
    "@types/jasmine": "~4.3.0",
    "@types/jasminewd2": "~2.0.13",
    "@types/node": "^16.18.12",
    "@typescript-eslint/eslint-plugin": "^5.59.2",
    "@typescript-eslint/parser": "^5.59.2",
    "angular-prerender": "^14.0.13",
    "browser-sync": "^3.0.0",
    "eslint": "^8.39.0",
    "jasmine-core": "~4.5.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.3",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.0.0",
    "prettier": "^2.8.3",
    "protractor": "~7.0.0",
    "ts-node": "~10.9.2",
    "typescript": "~5.9.3",
    "webpack": "^5.104.1"
  }
}
