{
	"name": "app",
	"version": "2.0.0",
	"engines": {
		"node": ">=22.0.0",
		"npm": ">=10.0.0"
	},
	"scripts": {
		"ng": "ng",
		"start": "npm run serve:ssr",
		"build": "ng build",
		"build:production": "npm run build:ssr && npm run prerender",
		"test": "ng test",
		"lint": "ng lint",
		"dev:ssr": "ng run app:serve-ssr",
		"serve:ssr": "node dist/app/server/server.mjs",
		"build:ssr": "ng build --configuration production",
		"stylelint": "stylelint \"src/**/*.scss\"",
		"format": "prettier --write ."
	},
	"private": true,
	"dependencies": {
		"@angular/common": "^21.2.0",
		"@angular/compiler": "^21.2.0",
		"@angular/core": "^21.2.15",
		"@angular/platform-browser": "^21.2.0",
		"@angular/platform-browser-dynamic": "^21.2.0",
		"@angular/platform-server": "^21.2.0",
		"@angular/router": "^21.2.0",
		"@angular/ssr": "^21.2.0",
		"@mdi/font": "^7.4.47",
		"express": "^5.2.1",
		"html-minifier-terser": "^7.2.0",
		"rxjs": "^7.8.2",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@angular-devkit/build-angular": "^21.2.0",
		"@angular-eslint/builder": "21.2.0",
		"@angular-eslint/eslint-plugin": "21.2.0",
		"@angular-eslint/eslint-plugin-template": "21.2.0",
		"@angular-eslint/schematics": "21.2.0",
		"@angular-eslint/template-parser": "21.2.0",
		"@angular/build": "^21.2.0",
		"@angular/cli": "^21.2.0",
		"@angular/compiler-cli": "^21.2.0",
		"@angular/language-service": "^21.2.0",
		"@types/express": "^5.0.6",
		"@types/html-minifier-terser": "^7.0.2",
		"@types/node": "^25.3.3",
		"@typescript-eslint/eslint-plugin": "^8.56.1",
		"@typescript-eslint/parser": "^8.56.1",
		"angular-cli-ghpages": "^3.0.2",
		"eslint": "^8.57.1",
		"jsdom": "^28.1.0",
		"prettier": "^3.8.1",
		"stylelint": "^17.4.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"typescript": "~5.9.0",
		"vitest": "^4.0.18"
	}
}
