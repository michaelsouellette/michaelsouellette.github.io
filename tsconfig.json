{
	"compileOnSave": false,
	"compilerOptions": {
    "baseUrl": "./",
    "downlevelIteration": true,
    "noUnusedLocals": true,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "lib": ["ES2022", "dom"],
    "typeRoots": [
      "node_modules/@types"
    ],
    "paths": {
      "@app/*": [
        "app/*"
      ],
      "@common/*": [
        "app/common/*"
      ],
      "@env/*": [
        "environments/*"
      ],
      "@feature/*": [
        "app/feature/*"
      ]
    }
  },
	"angularCompilerOptions": {
		"preserveWhitespaces": false,
		"fullTemplateTypeCheck": false
	},
	"exclude": ["node_modules", "tmp"]
}
