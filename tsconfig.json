{
	"compileOnSave": false,
	"compilerOptions": {
		"baseUrl": "./",
		"noUnusedLocals": true,
		"outDir": "./dist/out-tsc",
		"sourceMap": true,
		"declaration": false,
		"module": "esnext",
		"moduleResolution": "bundler",
		"experimentalDecorators": true,
		"importHelpers": true,
		"target": "ES2022",
		"typeRoots": ["node_modules/@types"],
		"lib": ["ES2022", "dom"],
		"strict": true
	},
	"angularCompilerOptions": {
		"preserveWhitespaces": false
	},
	"exclude": ["node_modules", "tmp"]
}
